<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>ArtiPlay Academy OS — Partner Onboarding</title>
<style>
:root{
  --navy:#17203a; --navy2:#202b49; --blue:#24375f; --gold:#cbb27a; --gold2:#e2d2a7;
  --ivory:#fbfaf6; --paper:#f5f2e8; --line:#ddd3b8; --text:#23283a; --muted:#72798a;
  --green:#3e7a63; --red:#a3492f;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:"Helvetica Neue",Arial,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:#e9e6de;color:var(--text);font-family:var(--sans);overflow:hidden}
body{padding:0}
button,input{font:inherit}
input{-webkit-tap-highlight-color:transparent}
button{cursor:pointer}
.app{
  width:100%;height:100vh;height:100dvh;margin:0;
  display:grid;grid-template-columns:370px minmax(0,1fr);overflow:hidden;border-radius:0;
  background:var(--ivory);box-shadow:none;border:0
}
.rail{
  background:linear-gradient(165deg,var(--navy) 0%,#141d34 55%,#0e1526 100%);color:#f5f2e8;padding:42px 30px 26px;
  display:flex;flex-direction:column;position:relative;overflow:hidden
}
.rail:after{content:none}
.rail:before{content:"";position:absolute;width:260px;height:260px;background:radial-gradient(circle,rgba(203,178,122,.12),transparent 70%);left:-120px;top:-80px;pointer-events:none}
.brand{position:relative;z-index:1}
.brand-word{font-size:25px;letter-spacing:.13em;font-weight:600}
.brand-sub{font-size:11px;letter-spacing:.22em;color:var(--gold2);margin-top:3px}
.rail-kicker{margin-top:55px;font-size:10px;letter-spacing:.2em;color:var(--gold2);font-weight:700}
.rail-title{font:400 34px/1.08 var(--serif);margin:12px 0 14px;max-width:280px}
.rail-copy{font:14px/1.65 var(--sans);color:#bfc5d2;max-width:285px}
.steps{margin-top:38px;display:grid;gap:4px;position:relative;z-index:1}
.step-row{display:grid;grid-template-columns:34px 1fr;gap:13px;align-items:center;min-height:56px;opacity:.5;padding:6px 10px;margin:0 -10px;border-radius:14px;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:opacity .3s ease,background .25s ease,transform .45s cubic-bezier(.34,1.56,.64,1)}
.step-row:hover{background:rgba(255,255,255,.05)}
.step-row:active{transform:scale(.97)}
.step-row.active,.step-row.done{opacity:1}
.step-row.active{background:rgba(255,255,255,.06);backdrop-filter:blur(6px)}
.step-dot{position:relative;width:34px;height:34px;border:1px solid rgba(255,255,255,.22);border-radius:50%;display:grid;place-items:center;font-size:10px;color:#aeb5c5;background:rgba(255,255,255,.03);backdrop-filter:blur(4px);transition:background .35s ease,border-color .35s ease,color .35s ease,box-shadow .35s ease,transform .45s cubic-bezier(.34,1.56,.64,1)}
.step-row:not(:last-child) .step-dot::before{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);width:1px;height:26px;background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(255,255,255,.04))}
.step-row.done:not(:last-child) .step-dot::before{background:linear-gradient(180deg,rgba(108,168,140,.55),rgba(108,168,140,.15))}
.step-row.active .step-dot{background:var(--gold);border-color:var(--gold);color:var(--navy);box-shadow:0 0 0 5px rgba(203,178,122,.12),0 0 18px rgba(203,178,122,.35);transform:scale(1.06)}
.step-row.done .step-dot{background:rgba(62,122,99,.28);border-color:#6ca88c;color:transparent}
.step-row.done .step-dot::after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;color:#bde0cf;font-size:13px;font-weight:800}
.step-name{font-size:12px;font-weight:700;letter-spacing:.04em}
.step-desc{font-size:10px;color:#8f98aa;margin-top:2px}
.rail-foot{margin-top:auto;padding-top:22px;display:flex;justify-content:center;position:relative;z-index:1}
.rail-foot span{font-size:8.5px;letter-spacing:.14em;color:#a9b0c2;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:999px;padding:7px 14px;backdrop-filter:blur(6px)}
.main{min-width:0;min-height:0;background:var(--ivory);display:flex;flex-direction:column}
.topbar{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 34px;border-bottom:1px solid #e5dfd1;background:rgba(251,250,246,.94)}
.top-status{font-size:10px;letter-spacing:.14em;color:#8b8f99;font-weight:700}
.top-secure{font-size:10px;color:#687081;display:flex;gap:8px;align-items:center}
.secure-dot{width:7px;height:7px;border-radius:50%;background:var(--green)}
.content{padding:38px 44px 30px;overflow-y:auto;-webkit-overflow-scrolling:touch;flex:1 1 auto;min-height:0}
.content::-webkit-scrollbar,.agreement-scroll::-webkit-scrollbar{width:8px}
.content::-webkit-scrollbar-thumb,.agreement-scroll::-webkit-scrollbar-thumb{background:#d7d0bf;border-radius:10px}
.eyebrow{font-size:10px;letter-spacing:.18em;color:#8b6b37;font-weight:800}
h1{font:400 40px/1.08 var(--serif);color:var(--navy);margin:9px 0 10px;letter-spacing:-.02em}
.lead{font:15px/1.65 var(--serif);color:#606676;max-width:760px;margin:0}
.step-page{display:none;animation:enter .28s ease}
.step-page.active{display:block}
@keyframes enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px;margin-top:28px}
.choice{border:1px solid #ddd7ca;background:#fffdf8;border-radius:16px;padding:20px;min-height:146px;text-align:left;transition:.2s;position:relative}
.choice:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(23,32,58,.07)}
.choice.selected{border-color:var(--blue);background:#f6f7fb;box-shadow:inset 0 0 0 1px var(--blue)}
.choice .check{position:absolute;right:15px;top:15px;width:22px;height:22px;border-radius:50%;border:1px solid #d2d0c8;display:grid;place-items:center;font-size:11px;color:transparent}
.choice.selected .check{background:var(--navy);border-color:var(--navy);color:#fff}
.ico{width:40px;height:40px;border-radius:12px;background:#eef0f5;color:var(--navy);display:grid;place-items:center;margin-bottom:17px}
.ico svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.choice-title{font-weight:800;font-size:13px;color:var(--navy)}
.choice-copy{font-size:11px;line-height:1.5;color:#777d8a;margin-top:5px}
.bottom{padding:18px 34px;border-top:1px solid #e5dfd1;display:flex;align-items:center;justify-content:space-between;background:#faf9f5;flex:0 0 auto}
.back{border:0;background:transparent;color:#707687;font-size:12px;font-weight:700;padding:12px 6px}
.primary{border:0;background:var(--navy);color:#fff;border-radius:11px;padding:13px 20px;font-size:12px;font-weight:800;min-width:170px;box-shadow:0 8px 20px rgba(23,32,58,.16);transition:transform .45s cubic-bezier(.34,1.56,.64,1),box-shadow .25s ease,background .25s ease;will-change:transform}
.primary:hover{transform:translateY(-1px);background:#10172b}
.primary:active{transform:scale(.94);box-shadow:0 4px 10px rgba(23,32,58,.16)}
.primary:disabled{opacity:.4;cursor:not-allowed;transform:none}
.secondary{border:1px solid #d8d3c7;background:#fffdf8;color:var(--navy);border-radius:11px;padding:12px 16px;font-size:12px;font-weight:800}
.summary-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px;margin-top:28px}
.panel{background:#fffdf8;border:1px solid #dfd9cd;border-radius:18px;padding:23px}
.panel-title{font-size:11px;letter-spacing:.14em;font-weight:800;color:#7e6742;margin-bottom:15px}
.commercial-list{display:grid;gap:0}
.commercial-row{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-bottom:1px solid #ece7dc;font-size:12px}
.commercial-row:last-child{border-bottom:0}
.commercial-row span:first-child{color:#747a88}
.commercial-row strong{color:var(--navy);text-align:right}
.price-card{background:var(--navy);color:#fff;border-radius:18px;padding:25px;position:relative;overflow:hidden}
.price-card:after{content:"";position:absolute;width:190px;height:190px;border:1px solid rgba(203,178,122,.2);border-radius:50%;right:-100px;top:-80px}
.price-label{font-size:9px;letter-spacing:.15em;color:var(--gold2);font-weight:800}
.price{font:400 38px var(--serif);margin-top:9px}
.price-note{font-size:11px;color:#aeb5c4;line-height:1.55;margin-top:5px}
.rule{height:1px;background:rgba(255,255,255,.12);margin:20px 0}
.feature-pills{display:flex;flex-wrap:wrap;gap:7px}
.pill{font-size:9px;padding:7px 9px;border:1px solid rgba(255,255,255,.12);border-radius:999px;color:#c9cfdb}
.review-strip{margin-top:18px;display:flex;align-items:center;justify-content:space-between;gap:15px;background:#f5f2e8;border:1px solid #dfd7c4;padding:14px 16px;border-radius:12px}
.review-strip span{font-size:11px;color:#626978}
.link-btn{border:0;background:transparent;color:#765c32;font-size:11px;font-weight:800;text-decoration:underline;text-underline-offset:3px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:27px}
.field{display:grid;gap:0;position:relative;background:#fffdf8;border:1px solid #e3ddcc;border-radius:14px;padding:11px 14px 12px;transition:border-color .25s ease,box-shadow .25s ease,transform .2s cubic-bezier(.34,1.56,.64,1);box-shadow:0 1px 2px rgba(23,32,58,.03)}
.field.full{grid-column:1/-1}
.field:focus-within{border-color:var(--navy);box-shadow:0 0 0 4px rgba(23,32,58,.08);transform:translateY(-1px)}
.field label{font-size:9px;letter-spacing:.1em;color:#9a9ea8;font-weight:800;transition:color .2s ease}
.field:focus-within label{color:var(--navy)}
.field input{width:100%;border:0;background:transparent;padding:5px 0 0;margin:0;color:var(--navy);font-size:14px;outline:none;font-family:var(--sans);-webkit-appearance:none;appearance:none}
.field input::placeholder{color:#c3bea9}
.field input[type="date"]{color-scheme:light;font-variant-numeric:tabular-nums}
.field input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(13%) sepia(22%) saturate(1200%) hue-rotate(190deg);opacity:.65;cursor:pointer;transition:opacity .2s ease}
.field input[type="date"]::-webkit-calendar-picker-indicator:hover{opacity:1}
.field input[inputmode="numeric"],.field input[type="tel"]{font-variant-numeric:tabular-nums;letter-spacing:.02em}
.signature-preview{margin-top:22px;border:1px dashed #c9c0a4;border-radius:16px;background:#fffdf8;padding:20px 18px;text-align:center;transition:border-color .25s ease,background .25s ease}
.signature-preview:has(.sig-name:not(:empty)){border-style:solid;border-color:var(--gold);background:#fffcf3}
.sig-name{font:italic 26px var(--serif);color:var(--navy);min-height:34px}
.consent{margin-top:17px;display:flex;gap:11px;align-items:flex-start;font-size:11px;line-height:1.55;color:#656b78;background:#fffdf8;border:1px solid #e3ddcc;border-radius:14px;padding:14px 16px;transition:border-color .2s ease,background .2s ease}
.consent:has(input:checked){border-color:var(--navy);background:#f6f7fb}
.consent input{margin-top:2px;width:17px;height:17px;accent-color:var(--navy);flex-shrink:0}
.pay-layout{display:grid;grid-template-columns:1fr 330px;gap:22px;margin-top:28px}
.bank-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:6px}
.bank-card{border:1px solid #ddd7ca;background:#fffdf8;border-radius:16px;padding:17px 18px;text-align:left;transition:.2s;position:relative}
.bank-card:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(23,32,58,.07)}
.bank-card.selected{border-color:var(--blue);background:#f6f7fb;box-shadow:inset 0 0 0 1px var(--blue)}
.bank-card .check{position:absolute;right:14px;top:14px;width:20px;height:20px;border-radius:50%;border:1px solid #d2d0c8;display:grid;place-items:center;font-size:10px;color:transparent}
.bank-card.selected .check{background:var(--navy);border-color:var(--navy);color:#fff}
.bank-name{font-weight:800;font-size:12.5px;color:var(--navy);letter-spacing:.02em}
.bank-account{font:16px/1.3 var(--serif);color:var(--navy);margin-top:8px;letter-spacing:.03em}
.bank-holder{font-size:10.5px;color:#7d8390;margin-top:4px}
.bank-copy{margin-top:10px;border:0;background:transparent;color:#765c32;font-size:10.5px;font-weight:800;text-decoration:underline;text-underline-offset:3px;padding:0}
.pay-instructions{margin-top:18px;background:#f5f2e8;border:1px solid #ddd3b8;border-radius:14px;padding:16px 18px}
.pay-instructions ol{margin:8px 0 0;padding-left:18px;font-size:11.5px;line-height:1.7;color:#4d5261}
.pay-instructions ol li{margin-bottom:2px}
.payment-note{font-size:10px;color:#858b98;line-height:1.5;margin-top:12px}
.ref-status{display:inline-flex;align-items:center;gap:6px;font-size:9.5px;font-weight:800;letter-spacing:.05em;padding:5px 10px;border-radius:999px;background:#f1ecdb;color:#8b6b37;margin-top:10px}
.ref-status.ok{background:#e9f3ee;color:#2f6b52}
.order-box{border:1px solid #ded9ce;border-radius:18px;background:#fffdf8;padding:22px;height:max-content}
.order-total{display:flex;justify-content:space-between;align-items:end;padding:17px 0;border-bottom:1px solid #e6e1d7}
.order-total span{font-size:11px;color:#777d88}
.order-total strong{font:28px var(--serif);color:var(--navy)}
.recurring{padding:15px 0;font-size:11px;color:#6d7380;display:flex;justify-content:space-between}
.delivery{margin-top:27px;display:grid;gap:11px}
.asset{display:flex;align-items:center;gap:13px;padding:14px;border:1px solid #e0dbd0;border-radius:13px;background:#fffdf8}
.asset-icon{width:38px;height:38px;border-radius:10px;background:#eef0f5;color:var(--navy);display:grid;place-items:center}
.asset-icon svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.6}
.asset-title{font-size:12px;font-weight:800;color:var(--navy)}
.asset-sub{font-size:10px;color:#858a95;margin-top:3px}
.success{margin-top:27px;background:#f1f7f3;border:1px solid #cfe2d6;border-radius:17px;padding:18px;display:flex;gap:14px;align-items:center}
.success.pending{background:#faf6e9;border-color:#e5d9ab}
.success-mark{width:40px;height:40px;border-radius:50%;background:#3e7a63;color:white;display:grid;place-items:center;font-weight:800}
.success.pending .success-mark{background:#b28c3a}
.success strong{font-size:12px;color:#275844}
.success.pending strong{color:#7a5c2e}
.success div:last-child{font-size:11px;color:#65766c;margin-top:3px}
/* Agreement modal */
.overlay{position:fixed;inset:0;background:rgba(13,19,35,.68);backdrop-filter:blur(8px);z-index:50;display:none;padding:0}
.overlay.open{display:flex}
.agreement-modal{width:100%;height:100%;margin:0;background:#e9e6de;border-radius:0;overflow:hidden;box-shadow:none;display:flex;flex-direction:column}
.modal-head{height:62px;background:var(--navy);color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 18px 0 24px;flex:0 0 auto}
.modal-title{font-size:11px;letter-spacing:.13em;font-weight:800}
.close{width:34px;height:34px;border-radius:50%;border:1px solid rgba(255,255,255,.22);background:transparent;color:#fff;display:grid;place-items:center;font-size:19px}

/* Apple-like hover tooltip — works on any element with [data-tooltip] */
[data-tooltip]{position:relative}
[data-tooltip]::after{
  content:attr(data-tooltip);
  position:absolute;
  top:50%;
  right:calc(100% + 9px);
  transform:translateY(-50%) translateX(4px) scale(.92);
  background:#1c1c1e;
  color:#fff;
  font-family:var(--sans);
  font-size:10px;
  font-weight:600;
  letter-spacing:.01em;
  padding:6px 10px;
  border-radius:7px;
  white-space:nowrap;
  pointer-events:none;
  opacity:0;
  box-shadow:0 8px 20px rgba(0,0,0,.22);
  transition:opacity .16s ease, transform .16s cubic-bezier(.34,1.56,.64,1);
  z-index:80;
}
[data-tooltip]:hover::after,[data-tooltip]:focus-visible::after{opacity:1;transform:translateY(-50%) translateX(0) scale(1)}
@media(max-width:700px){[data-tooltip]::after,[data-tooltip]::before{display:none}}
.modal-head-right{display:flex;align-items:center;gap:14px}
.tb-status{font-family:"Helvetica Neue",Arial,sans-serif;font-size:9px;color:#a9b0c2;min-width:110px;text-align:right}
.icon-group{display:flex;align-items:center;gap:6px;background:rgba(242,239,230,.08);border:1px solid rgba(242,239,230,.14);border-radius:999px;padding:4px}
.icon-btn{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.28);border-radius:50%;width:34px;height:34px;padding:0;display:inline-flex;align-items:center;justify-content:center;transition:background .15s ease,border-color .15s ease,transform .1s ease}
.icon-btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.icon-btn:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.5)}
.icon-btn:active{transform:scale(.94)}
.icon-btn:disabled{opacity:.45;cursor:not-allowed}
.agreement-scroll{overflow:auto;flex:1}
.agreement-doc{max-width:820px;margin:28px auto 40px;background:var(--ivory);box-shadow:0 4px 28px rgba(23,32,58,.18)}
.agreement-doc .cover{min-height:760px;padding:55px 62px;display:flex;flex-direction:column;background:#fbfaf6;position:relative}
.agreement-doc .letterhead{display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--navy);padding-bottom:18px}
.agreement-doc .mark-word{font-size:15px;letter-spacing:.08em;color:var(--navy);font-weight:600}
.agreement-doc .mark-sub{font-size:10px;letter-spacing:.12em;color:#7a5c2e}
.agreement-doc .letterhead-doc{text-align:right;font-size:10px;color:#6b7180;line-height:1.5}
.agreement-doc .cover-title-block{margin-top:130px;text-align:center}
.agreement-doc .cover-kicker,.agreement-doc .part-kicker{font-size:10px;letter-spacing:.14em;color:#7a5c2e;font-weight:700}
.agreement-doc .cover-title{font:400 34px/1.25 var(--serif);color:var(--navy);max-width:600px;margin:10px auto 16px}
.agreement-doc .cover-rule{width:170px;height:1px;background:var(--gold);margin:20px auto}
.agreement-doc .cover-subtitle{font:italic 15px/1.55 var(--serif);color:#4d5261;max-width:530px;margin:auto}
.agreement-doc .parties-block{margin:55px auto 0;max-width:650px;width:100%;display:flex;border-top:1px solid #d9d2c0;border-bottom:1px solid #d9d2c0;padding:25px 0}
.agreement-doc .party{flex:1;text-align:center}
.agreement-doc .party+.party{border-left:1px solid #d9d2c0}
.agreement-doc .p-label,.agreement-doc .cover-footer .label,.agreement-doc .sl-label{font-size:9px;letter-spacing:.1em;color:#9b9481}
.agreement-doc .p-value{font:16px var(--serif);color:var(--navy);margin-top:5px}
.agreement-doc .cover-tags{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 25px;margin-top:25px;font-size:10px;color:#6b7180}
.agreement-doc .cover-tags span::before{content:"· ";color:var(--gold)}
.agreement-doc .cover-tags span:first-child::before{content:""}
.agreement-doc .cover-footer{margin-top:auto;padding-top:25px;display:flex;justify-content:space-between;gap:15px;border-top:1px solid #d9d2c0;align-items:end}
.agreement-doc .cover-footer-tagline{font:italic 13px var(--serif);color:#7a5c2e}
.agreement-doc .toc,.agreement-doc .page-inner{padding:48px 62px 25px}
.agreement-doc .toc{border-bottom:1px solid #e4dfd4}
.agreement-doc .toc-heading{font-size:10px;letter-spacing:.14em;color:#7a5c2e}
.agreement-doc .toc-title{font:400 22px var(--serif);color:var(--navy);margin:5px 0 25px;border-bottom:2px solid var(--navy);padding-bottom:13px}
.agreement-doc .toc-row{display:flex;gap:18px;padding:11px 0;border-bottom:1px dotted #d9d2c0;text-decoration:none;color:inherit}
.agreement-doc .toc-num,.agreement-doc .sec-num{color:#7a5c2e;font-size:12px}
.agreement-doc .toc-label{font-size:13px}
.agreement-doc .part{padding:28px 0 5px;scroll-margin-top:70px}
.agreement-doc .part-title{font:400 23px var(--serif);color:var(--navy);margin:5px 0 25px;border-bottom:2px solid var(--navy);padding-bottom:14px}
.agreement-doc .sec{margin-bottom:25px}
.agreement-doc .sec-head{display:flex;gap:8px;align-items:baseline;margin-bottom:7px}
.agreement-doc .sec-title{font-size:15px;font-weight:800;color:var(--navy)}
.agreement-doc .sec p,.agreement-doc .sec li{font:14px/1.68 var(--serif);color:#383d4a}
.agreement-doc .sec p{margin:0 0 10px}
.agreement-doc .sec ul{margin:7px 0 12px;padding-left:22px}
.agreement-doc .sec li{margin-bottom:5px}
.agreement-doc .callout-row{display:flex;gap:14px;flex-wrap:wrap;margin:13px 0}
.agreement-doc .callout{flex:1;min-width:230px;background:#f5f2e8;border:1px solid #ddd3b8;border-left:3px solid #7a5c2e;padding:15px 18px}
