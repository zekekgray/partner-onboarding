<script>
(function(){
  const pages=[1,2,3,4,5];
  let current=1;
  let maxReached=1;
  const selected=new Set(["White-Label","Academy Operations"]);
  let selectedBank=null;
  let resizeSignaturePad=null;

  /* ============================================================
     PRICING ENGINE — single source of truth for every ₱ shown
     in Step 2 (Review) and Step 4 (Payment). Every number the UI
     displays is computed here, never hand-typed elsewhere, so
     the source of any figure is always traceable to one of the
     line items below.

     CONFIRMED WITH BUSINESS (from Agreement Article II & VI):
       - setupFee.discounted / .regular   → §2.1 Founding Academy Pricing
       - recurring tiers (999 / 2,999)    → confirmed by academy owner
       - referral.commissionPct           → §6.1 Direct Referral Commission
     ASSUMED — NOT YET CONFIRMED (flagged so they're easy to find/change):
       - headcount definition             → assumed players+coaches combined
       - module add-on pricing            → assumed $0, bundled in tier
       - tax handling                     → assumed tax-inclusive, no VAT line
     ============================================================ */
  const PRICING_CONFIG = {
    currency: '₱',

    // ---- ONE-TIME SETUP / DEPLOYMENT FEE (Agreement §2.1) ----
    setupFee: {
      regular: 35000,      // standard reference deployment price, no discount
      discounted: 15000,   // Founding Academy one-time price (what this flow charges)
      discountLabel: 'Founding Academy discount'
    },

    // ---- RECURRING PLATFORM & INFRASTRUCTURE FEE (Agreement §2.2) ----
    // Tiered by total active seats (players + coaches/staff) on the tenant.
    // ASSUMPTION: headcount = players + coaches/staff combined. Confirm and
    // edit `headcountDefinition` + the tier `upTo` value if that's wrong.
    headcountDefinition: 'players + coaches/staff combined',
    recurringTiers: [
      { upTo: 250,        monthly: 999  },  // 1–250 total seats
      { upTo: Infinity,   monthly: 2999 }   // 251+ total seats
    ],

    // ---- MODULES SELECTED IN STEP 1 ----
    // ASSUMPTION: all modules (AI-Assisted, Rewards, Dashboards, Referral)
    // are bundled into the recurring tier fee above at ₱0 add-on cost, per
    // Agreement §2.2 ("continued access to supported ArtiPlay features").
    // To make a module chargeable, give it a non-zero `monthly` here —
    // the render layer will automatically pick it up and itemize it.
    moduleAddOns: {
      'White-Label':              0,
      'Academy Operations':       0,
      'AI-Assisted':              0,
      'Rewards & Engagement':     0,
      'Dashboards & Analytics':   0,
      'Referral Partner':         0
    },

    // ---- DISCOUNTS ----
    // Founding Academy pricing IS the discount (35,000 → 15,000). No
    // separate promo-code or seasonal-discount system exists yet — this
    // object is a placeholder for future coupon/discount codes.
    promoDiscounts: {
      // 'CODE123': { type:'percent', value:10, appliesTo:'setup' }
    },

    // ---- TAX ----
    // ASSUMPTION: tax-inclusive, no separate VAT line, because the signed
    // Agreement's commercial tables (§2.1, §2.2, §9.2) show no VAT line
    // item. If the business becomes VAT-registered and wants VAT broken
    // out, set `mode` to 'exclusive' and `ratePct` to e.g. 12 — the render
    // layer will then show a separate "VAT (12%)" line automatically.
    tax: { mode: 'inclusive', ratePct: 0, label: 'VAT' },

    // ---- SETUP FEE PRORATION / TRIAL / BILLING CYCLE ----
    // No trial period exists in the current Agreement. Setup fee is due
    // before deployment (Agreement §7.1); recurring fee bills monthly on
    // the Academy's billing date, no mid-cycle proration defined yet.
    billingCycle: 'monthly',
    trialDays: 0,
    setupFeeProration: false,

    // ---- RENEWAL / CANCELLATION / REFUND ----
    // Renewal: recurring fee auto-continues monthly until terminated
    // (Agreement §7.1). Cancellation: either party per §7.3 — no early
    // termination fee defined. Refund: setup fee is non-refundable once
    // deployment has started; monthly fee is non-refundable/non-prorated
    // for the current billing cycle upon cancellation.
    renewalPolicy: 'auto-continues monthly until terminated (§7.1, §7.3)',
    cancellationPolicy: 'either party, per §7.3 — no early-termination fee on file',
      refundPolicy: 'Setup fee non-refundable once deployment has started; monthly platform fee non-refundable and non-prorated for the current billing cycle upon cancellation',

    // ---- REFERRAL COMMISSION (Agreement §6.1) ----
    referral: {
      commissionPct: 50,          // % of the ACTUAL setup fee received, not the ₱35,000 reference price
      appliesTo: 'setupFeeOnly',  // recurring monthly fee is NOT commissionable per §6.1
      attributionWindowDays: 90,  // §6.2
      payoutBusinessDays: 15      // §6.2
    }
  };

  // Returns the recurring monthly fee for a given headcount, per the tier table above.
  function getRecurringTier(headcount){
    const n = Math.max(0, parseInt(headcount, 10) || 0);
    for(const tier of PRICING_CONFIG.recurringTiers){
      if(n <= tier.upTo) return tier;
    }
    return PRICING_CONFIG.recurringTiers[PRICING_CONFIG.recurringTiers.length - 1];
  }

  // Full computed breakdown — every field here maps 1:1 to a line in the UI.
  // isFounding=true uses the discounted ₱15,000 setup fee; false uses ₱35,000.
  function computePricing(headcount, isFounding){
    const cfg = PRICING_CONFIG;
    const tier = getRecurringTier(headcount);
    const setup = isFounding ? cfg.setupFee.discounted : cfg.setupFee.regular;
    const setupDiscountAmount = isFounding ? (cfg.setupFee.regular - cfg.setupFee.discounted) : 0;
    const moduleAddOnTotal = Object.values(cfg.moduleAddOns).reduce((a,b)=>a+b, 0); // currently always 0 — see moduleAddOns comment
    const recurringBeforeTax = tier.monthly + moduleAddOnTotal;
    const taxAmount = cfg.tax.mode === 'exclusive' ? Math.round(recurringBeforeTax * (cfg.tax.ratePct/100)) : 0;
    const recurringTotal = recurringBeforeTax + taxAmount;
    const referralCommission = Math.round(setup * (cfg.referral.commissionPct/100));
    return {
      headcount: Math.max(0, parseInt(headcount,10) || 0),
      tierLabel: tier.upTo === Infinity ? `${tier.upTo === Infinity ? 'Above ' + (cfg.recurringTiers[0].upTo) : ''}` : `Up to ${tier.upTo}`,
      setupFee: setup,
      setupFeeRegular: cfg.setupFee.regular,
      setupDiscountAmount,
      moduleAddOnTotal,
      recurringBase: tier.monthly,
      taxAmount,
      taxLabel: cfg.tax.label,
      taxMode: cfg.tax.mode,
      recurringTotal,
      dueToday: setup,
      grandTotalDueToday: setup + recurringTotal, // ASSUMPTION: first month is billed together with the setup fee at signup — confirm with business, edit here if setup-only
      referralCommission,
      referralPct: cfg.referral.commissionPct
    };
  }

  function fmtPeso(n){ return PRICING_CONFIG.currency + Number(n||0).toLocaleString('en-PH'); }

  const $=id=>document.getElementById(id);

  function showToast(message, type){
    const stack=$('toastStack');
    if(!stack){ alert(message); return; }
    const el=document.createElement('div');
    el.className='toast '+(type||'warn');
    el.innerHTML='<span class="toast-icon">'+(type==='error'?'!':'i')+'</span><span class="toast-msg"></span><button type="button" class="toast-close" aria-label="Dismiss">×</button>';
    el.querySelector('.toast-msg').textContent=message;
    stack.appendChild(el);
    requestAnimationFrame(()=>el.classList.add('show'));
    function dismiss(){
      el.classList.add('leaving');
      el.classList.remove('show');
      setTimeout(()=>el.remove(),260);
    }
    el.querySelector('.toast-close').addEventListener('click',dismiss);
    setTimeout(dismiss,4200);
  }

  function guideToField(el){
    if(!el) return;
    el.scrollIntoView({behavior:'smooth',block:'center'});
    setTimeout(()=>{ el.focus({preventScroll:true}); },320);
  }

  function render(){
    pages.forEach(n=>$('step'+n).classList.toggle('active',n===current));
    document.querySelectorAll('.step-row').forEach(row=>{
      const n=+row.dataset.step;
      row.classList.toggle('active',n===current);
      row.classList.toggle('done',n<current);
    });
    if(current>maxReached) maxReached=current;
    if(current===3){
      const padEl=$('acad_signature_pad');
      if(padEl && padEl.width===0 && resizeSignaturePad) resizeSignaturePad();
    }
    if(current===4){
      const amtEl=$('pay_amount');
      if(amtEl && !amtEl.value.trim()){
        const p=computePricing(getHeadcountValue(), true);
        amtEl.value=p.grandTotalDueToday;
      }
      updateAmountStatus();
    }
    const labels={
      1:['PARTNERSHIP & PLATFORM LICENSE','Next'],
      2:['COMMERCIAL & LEGAL REVIEW','Next'],
      3:['ACADEMY ACCEPTANCE','Next'],
      4:['BANK TRANSFER & VERIFICATION','Submit for verification →'],
      5:['DIGITAL DELIVERY','Finish']
    };
    $('topStatus').textContent=labels[current][0];
    $('nextBtn').textContent=labels[current][1];
    $('backBtn').style.visibility=current===1?'hidden':'visible';
    $('footerStatus').textContent=current===1?selected.size+' capabilities selected.':current===5?'Awaiting admin verification.':'Step '+current+' of 5';
    $('selectedCount').textContent=selected.size+' feature'+(selected.size===1?'':'s');
    renderPricing();
    if(current===5){
      $('finalAcademy').textContent=$('acad_name').value||'Academy';
      $('finalEmail').textContent=$('acad_email').value||'registered email';
      $('finalSignedBy').textContent=$('acad_rep').value||'—';
      $('finalBank').textContent=$('pay_bank').value||'—';
      $('finalReference').textContent=$('pay_reference').value||'—';
      const sigImg=$('finalSignatureImg');
      if(sigImg){
        if(acadSignatureDataUrl){ sigImg.src=acadSignatureDataUrl; sigImg.style.display='inline-block'; }
        else { sigImg.style.display='none'; }
      }
      $('deliveryMessage').textContent='Digital package prepared for '+($('acad_email').value||'the registered email')+'. It will be sent automatically once ArtiPlay Admin approves the submitted payment reference.';
    }
  }

  document.querySelectorAll('.choice').forEach(btn=>btn.addEventListener('click',()=>{
    const key=btn.dataset.feature;
    if(selected.has(key)) selected.delete(key); else selected.add(key);
    btn.classList.toggle('selected',selected.has(key));
    render();
  }));

  // Bank / e-wallet selection
  document.querySelectorAll('.bank-card').forEach(card=>{
    card.addEventListener('click',(e)=>{
      if(e.target.classList.contains('bank-copy')) return; // handled separately
      document.querySelectorAll('.bank-card').forEach(c=>c.classList.remove('selected'));
      card.classList.add('selected');
      selectedBank=card.dataset.bank;
      const holder=card.dataset.holder?(' — '+card.dataset.holder):'';
      $('pay_bank').value=card.dataset.bank+' · '+card.dataset.account+holder;
    });
  });
  document.querySelectorAll('.bank-copy').forEach(btn=>{
    btn.addEventListener('click',(e)=>{
      e.stopPropagation();
      const text=btn.dataset.copy;
      if(navigator.clipboard && navigator.clipboard.writeText){
        navigator.clipboard.writeText(text).then(()=>{
          const original=btn.textContent;
          btn.textContent='Copied ✓';
          setTimeout(()=>{btn.textContent=original;},1400);
        }).catch(()=>{});
      }
    });
  });

  function refIsValid(){
    return $('pay_reference').value.trim().length>=4;
  }
  function updateAmountStatus(){
    const el=$('pay_amount');
    const note=$('amountMismatchNote');
    if(!el || !note) return;
    const entered=parseFloat(el.value.replace(/[^0-9.]/g,''))||0;
    const p=computePricing(getHeadcountValue(), true);
    note.style.display = (entered>0 && entered!==p.grandTotalDueToday) ? 'block' : 'none';
  }
  function updateRefStatus(){
    const el=$('refStatus');
    if(refIsValid()){
      el.textContent='Reference number captured — ready to submit';
      el.classList.add('ok');
    } else {
      el.textContent='Awaiting reference number';
      el.classList.remove('ok');
    }
  }
  $('pay_reference').addEventListener('input',updateRefStatus);
  const payAmountEl=$('pay_amount');
  if(payAmountEl) payAmountEl.addEventListener('input',updateAmountStatus);

  function validStep(){
    if(current===1 && selected.size===0){ guideToField(document.querySelector('.choice-grid')); showToast('Please select at least one capability.','warn'); return false; }
    if(current===1){
      const hc=$('headcount_input').value.trim();
      if(!hc || !/^[0-9]+$/.test(hc) || parseInt(hc,10)<=0){
        guideToField($('headcount_input'));
        showToast('Please enter a valid number of players + coaches/staff.','warn');
        return false;
      }
    }
    if(current===3){
      const required=['acad_name','acad_rep','acad_email','acad_date'];
      const missing=required.find(id=>!$(id).value.trim());
      if(missing){ guideToField($(missing)); showToast('Please complete the required Academy fields before continuing.','warn'); return false; }
      if(acadSignatureEmpty){
        guideToField($('acad_signature_pad'));
        showToast('Please draw your signature before continuing.','warn');
        return false;
      }
      if(!$('acad_consent').checked){ guideToField($('acad_consent')); showToast('Please confirm the e-signature acceptance.','warn');return false;}
    }
    if(current===4){
      if(!selectedBank){ guideToField(document.getElementById('bankGrid')); showToast('Please select the account you sent the payment to.','warn'); return false; }
      const amtVal=$('pay_amount').value.trim();
      if(!amtVal){ guideToField($('pay_amount')); showToast('Please enter the amount you sent.','warn'); return false; }
      const enteredAmt=parseFloat(amtVal.replace(/[^0-9.]/g,''))||0;
      const expectedAmt=computePricing(getHeadcountValue(), true).grandTotalDueToday;
      if(enteredAmt!==expectedAmt){
        guideToField($('pay_amount'));
        showToast('The amount sent ('+fmtPeso(enteredAmt)+') doesn\'t match the grand total due today ('+fmtPeso(expectedAmt)+'). Please verify.','error');
        return false;
      }
      if(!refIsValid()){ guideToField($('pay_reference')); showToast('Please enter the payment reference / transaction number from your receipt.','warn'); return false; }
    }
    return true;
  }

  function hapticTap(){ if(navigator.vibrate) navigator.vibrate(8); }

  function finishSubmission(){
    $('thanksEmail').textContent=$('acad_email').value||'your registered address';
    document.querySelector('.app').style.display='none';
    $('agreementFab').style.display='none';
    $('thankYouFull').classList.add('show');
    // Lock navigation: block back button and any further app interaction.
    history.pushState(null, '', location.href);
    window.addEventListener('popstate', ()=>{ history.pushState(null, '', location.href); });
  }

  $('nextBtn').addEventListener('click',()=>{
    if(!validStep()) return;
    hapticTap();
    if(current<5){ current++; render(); return; }
    if(current===5){ finishSubmission(); return; }
  });
  $('backBtn').addEventListener('click',()=>{ hapticTap(); if(current>1) current--;render();});

  document.querySelectorAll('.step-row').forEach(row=>{
    row.addEventListener('click',()=>{
      const n=+row.dataset.step;
      if(n<=maxReached && n!==current){ hapticTap(); current=n; render(); }
    });
  });

  let acadSignatureEmpty = true;
  let acadSignatureDataUrl = '';
  (function initSignaturePad(){
    const canvas = $('acad_signature_pad');
    if(!canvas) return;
    const ctx = canvas.getContext('2d');
    let drawing = false, lastX = 0, lastY = 0;
    function resizeCanvas(){
      const ratio = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * ratio;
      canvas.height = 160 * ratio;
      ctx.scale(ratio, ratio);
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#17203a';
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    resizeSignaturePad = resizeCanvas;
    function pos(e){
      const rect = canvas.getBoundingClientRect();
      return { x: (e.clientX - rect.left), y: (e.clientY - rect.top) };
    }
    function start(e){
      drawing = true; acadSignatureEmpty = false;
      const p = pos(e); lastX = p.x; lastY = p.y;
      if(e.pointerId!=null && canvas.setPointerCapture) canvas.setPointerCapture(e.pointerId);
    }
    function move(e){
      if(!drawing) return;
      const p = pos(e);
      ctx.beginPath(); ctx.moveTo(lastX, lastY); ctx.lineTo(p.x, p.y); ctx.stroke();
      lastX = p.x; lastY = p.y;
    }
    function end(){
      if(!drawing) return;
      drawing = false;
      acadSignatureDataUrl = canvas.toDataURL('image/png');
    }
    canvas.addEventListener('pointerdown', start);
    canvas.addEventListener('pointermove', move);
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointerleave', end);
    $('sigClearBtn').addEventListener('click', ()=>{
      const rect = canvas.getBoundingClientRect();
      ctx.clearRect(0,0,rect.width,160);
      acadSignatureEmpty = true;
      acadSignatureDataUrl = '';
    });
  })();

  function openCompleteAgreement(){
    const overlay = $('agreementOverlay');
    if(!overlay) return;
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden','false');
    document.body.classList.add('agreement-open');
    const scroll = overlay.querySelector('.agreement-scroll');
    if(scroll) scroll.scrollTop = 0;
  }
  $('openAgreement').addEventListener('click',openCompleteAgreement);
  $('agreementLauncher').addEventListener('click',openCompleteAgreement);
  $('agreementFab').addEventListener('click',openCompleteAgreement);
  $('closeAgreement').addEventListener('click',()=>{ $('agreementOverlay').classList.remove('open'); $('agreementOverlay').setAttribute('aria-hidden','true'); document.body.classList.remove('agreement-open'); });
  $('agreementOverlay').addEventListener('click',e=>{if(e.target===$('agreementOverlay')) $('closeAgreement').click();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape' && $('agreementOverlay').classList.contains('open')) $('closeAgreement').click();});

  // Preserve the original Agreement's Google Apps Script hooks when this file
  // is served inside HTML Service. The original IDs remain in the agreement modal.
  window.collectAgreementData=function(){
    const ids=['prov_rep','prov_position','prov_signature','prov_date','prov_consent','acad_name','acad_rep','acad_position','acad_date','acad_consent','acad_email','acad_mobile','acad_address'];
    const data={};
    ids.forEach(id=>{const el=$(id); if(el) data[id]=el.type==='checkbox'?el.checked:el.value;});
    data.acad_signature = acadSignatureDataUrl;
    data.payment_bank=$('pay_bank')?$('pay_bank').value:'';
    data.payment_amount=$('pay_amount')?$('pay_amount').value:'';
    data.payment_reference=$('pay_reference')?$('pay_reference').value:'';
    data.timestamp=new Date().toISOString();
    return data;
  };

  function tbSetStatus(msg,isError){
    const s=$('tb-status'); if(!s) return;
    s.textContent=msg; s.style.color=isError?'#e39a9a':'#a9b0c2';
  }
  function tbToggleButtons(disabled){
    const save=$('btn-save'), pdf=$('btn-pdf');
    if(save) save.disabled=disabled;
    if(pdf) pdf.disabled=disabled;
  }
  function tbFirstMissingRequired(){
    const req=['acad_name','acad_rep','acad_date','acad_email','acad_consent'];
    for(const id of req){
      const el=$(id); if(!el) continue;
      const empty=el.type==='checkbox'?!el.checked:!el.value.trim();
      if(empty) return el;
    }
    if(acadSignatureEmpty) return $('acad_signature_pad');
    return null;
  }
  function tbValidateOrWarn(){
    const missing=tbFirstMissingRequired();
    if(missing){ tbSetStatus('Please complete: '+missing.id,true); missing.focus(); return false; }
    return true;
  }
  function tbHasGoogleScript(){ return typeof google!=='undefined'&&google.script&&google.script.run; }
  function tbWithTimeout(seconds){
    return setTimeout(()=>{ tbToggleButtons(false); tbSetStatus('No response from server. Try again.',true); },seconds*1000);
  }

  window.saveAgreement=function(){
    if(!tbValidateOrWarn()) return;
    if(!tbHasGoogleScript()){ tbSetStatus('Google Apps Script is not available in this preview.',true); return; }
    tbToggleButtons(true); tbSetStatus('Saving...');
    const timer=tbWithTimeout(20);
    const data=window.collectAgreementData();
    google.script.run.withSuccessHandler(res=>{clearTimeout(timer);tbToggleButtons(false);tbSetStatus('Saved to Sheet ✓'+(res&&res.row?(' (row '+res.row+')'):''));}).withFailureHandler(err=>{clearTimeout(timer);tbToggleButtons(false);tbSetStatus('Error: '+err.message,true);}).saveAgreementToSheet(data);
  };

  window.generatePdf=function(){
    if(!tbValidateOrWarn()) return;
    if(!tbHasGoogleScript()){ tbSetStatus('Google Apps Script is not available in this preview.',true); return; }
    tbToggleButtons(true); tbSetStatus('Generating PDF...');
    const timer=tbWithTimeout(30);
    const data=window.collectAgreementData();
    google.script.run.withSuccessHandler(res=>{clearTimeout(timer);tbToggleButtons(false);tbSetStatus('PDF ready ✓');window.open(res.url,'_blank');}).withFailureHandler(err=>{clearTimeout(timer);tbToggleButtons(false);tbSetStatus('Error: '+err.message,true);}).generateAgreementPdf(data);
  };

  (function trackDirty(){
    const ids=['prov_rep','prov_position','prov_signature','prov_date','prov_consent','acad_name','acad_rep','acad_position','acad_signature','acad_date','acad_consent','acad_email','acad_mobile','acad_address'];
    let dirty=false;
    ids.forEach(id=>{
      const el=$(id); if(!el) return;
      const mark=()=>{ if(!dirty){ dirty=true; tbSetStatus('Unsaved changes...'); } };
      el.addEventListener('input',mark);
      el.addEventListener('change',mark);
    });
  })();

  if(window.__ARTIPLAY_PREFILL__){
    Object.keys(window.__ARTIPLAY_PREFILL__).forEach(id=>{
      const el=$(id); if(el && el.type!=='checkbox') el.value=window.__ARTIPLAY_PREFILL__[id];
    });
  }

  // Auto-tooltip: any button with aria-label/title gets a hover overlay,
  // no manual tagging needed per button.
  document.querySelectorAll('button[aria-label], button[title]').forEach(btn=>{
    if(!btn.hasAttribute('data-tooltip')){
      const label=btn.getAttribute('aria-label')||btn.getAttribute('title');
      if(label) btn.setAttribute('data-tooltip',label);
    }
    btn.removeAttribute('title'); // avoid native browser tooltip double-up
  });

  // ---- Pricing render: pulls every ₱ figure from PRICING_CONFIG / computePricing() ----
  function getHeadcountValue(){
    const el = $('headcount_input');
    return el ? (parseInt((el.value||'').replace(/[^0-9]/g,''),10) || 0) : 0;
  }
  function renderPricing(){
    const headcount = getHeadcountValue();
    const p = computePricing(headcount, true /* Founding Academy discount applies */);
    const tierText = headcount>0 ? (headcount<=PRICING_CONFIG.recurringTiers[0].upTo ? `Up to ${PRICING_CONFIG.recurringTiers[0].upTo} seats · ${headcount} entered` : `${PRICING_CONFIG.recurringTiers[0].upTo}+ seats · ${headcount} entered`) : 'Enter headcount in Step 1';
    const recurText = fmtPeso(p.recurringBase)+' / month';

    // Step 1 tier preview chip
    const tierPreviewEl = $('tierPreview');
    if(tierPreviewEl){
      if(headcount>0){
        tierPreviewEl.textContent = `${headcount} total seats → ${fmtPeso(p.recurringBase)}/month tier`;
        tierPreviewEl.classList.add('ok');
      } else {
        tierPreviewEl.textContent = 'Enter a headcount to see your monthly tier';
        tierPreviewEl.classList.remove('ok');
      }
    }

    // Step 2 commercial summary panel
    if($('sumRegularSetup')) $('sumRegularSetup').textContent = fmtPeso(p.setupFeeRegular);
    if($('sumDiscountAmount')) $('sumDiscountAmount').textContent = '−'+fmtPeso(p.setupDiscountAmount);
    if($('sumSetupFee')) $('sumSetupFee').textContent = fmtPeso(p.setupFee)+' one-time';
    if($('sumTierLabel')) $('sumTierLabel').textContent = tierText;
    if($('sumRecurring')) $('sumRecurring').textContent = recurText;
    if($('sumModuleAddOns')) $('sumModuleAddOns').textContent = p.moduleAddOnTotal>0 ? fmtPeso(p.moduleAddOnTotal)+' / month' : '₱0 — bundled in tier';
    if($('sumReferralPct')) $('sumReferralPct').textContent = p.referralPct+'% of the actual setup fee received';
    const sumTaxRow = $('sumTaxRow');
    if(sumTaxRow){
      if(p.taxMode==='exclusive' && p.taxAmount>0){
        sumTaxRow.style.display='';
        $('sumTaxLabel').textContent = p.taxLabel+' ('+PRICING_CONFIG.tax.ratePct+'%)';
        $('sumTaxAmount').textContent = fmtPeso(p.taxAmount);
      } else { sumTaxRow.style.display='none'; }
    }

    // Step 2 price card
    if($('priceCardSetup')) $('priceCardSetup').textContent = fmtPeso(p.setupFee);
    if($('priceCardRecurring')) $('priceCardRecurring').textContent = recurText;
    if($('priceCardTierNote')) $('priceCardTierNote').textContent = headcount>0
      ? `Platform & infrastructure fee — ${tierText}.`
      : `Platform & infrastructure fee. Enter your academy's headcount in Step 1 to confirm your tier.`;
    if($('priceCardGrandTotal')) $('priceCardGrandTotal').textContent = fmtPeso(p.grandTotalDueToday);

    // Step 4 order summary
    if($('orderSetupFee')) $('orderSetupFee').textContent = fmtPeso(p.setupFee);
    if($('orderFirstMonth')) $('orderFirstMonth').textContent = fmtPeso(p.recurringTotal);
    if($('orderDueToday')) $('orderDueToday').textContent = fmtPeso(p.grandTotalDueToday);
    if($('orderRecurring')) $('orderRecurring').textContent = recurText;
    if($('orderHeadcount')) $('orderHeadcount').textContent = headcount>0 ? (headcount+' seats · '+tierText.split(' · ')[0]) : 'Not entered';
    const orderTaxRow = $('orderTaxRow');
    if(orderTaxRow){
      if(p.taxMode==='exclusive' && p.taxAmount>0){
        orderTaxRow.style.display='';
        $('orderTaxLabel').textContent = p.taxLabel+' ('+PRICING_CONFIG.tax.ratePct+'%)';
        $('orderTaxAmount').textContent = fmtPeso(p.taxAmount);
      } else { orderTaxRow.style.display='none'; }
    }
  }
  const headcountEl = $('headcount_input');
  if(headcountEl){
    headcountEl.addEventListener('input', ()=>{
      const cleaned = headcountEl.value.replace(/[^0-9]/g,'');
      if(headcountEl.value !== cleaned) headcountEl.value = cleaned;
      renderPricing();
    });
  }

  render();
})();

/* ===== Find & replace within the agreement document ===== */
function frGetRoot(){ return document.querySelector('.agreement-doc'); }
function frEscapeRegExp(s){ return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'); }

function frCountMatches(query){
  if(!query) return 0;
  const root=frGetRoot();
  if(!root) return 0;
  const walker=document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
  const re=new RegExp(frEscapeRegExp(query),'gi');
  let count=0, node;
  while(node=walker.nextNode()){
    const m=node.nodeValue.match(re);
    if(m) count+=m.length;
  }
  return count;
}

function frReplaceAll(query, replacement){
  if(!query) return 0;
  const root=frGetRoot();
  if(!root) return 0;
  const walker=document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
  const re=new RegExp(frEscapeRegExp(query),'gi');
  const nodes=[];
  let node;
  while(node=walker.nextNode()) nodes.push(node);
  let count=0;
  nodes.forEach(n=>{
    const m=n.nodeValue.match(re);
    if(m){ count+=m.length; n.nodeValue=n.nodeValue.replace(re, replacement); }
  });
  return count;
}

function toggleFindReplace(){
  const bar=document.getElementById('frBar');
  if(!bar) return;
  const showing=bar.style.display!=='none';
  bar.style.display=showing?'none':'flex';
  if(!showing) document.getElementById('frFind').focus();
}

(function initFindReplace(){
  const findInput=document.getElementById('frFind');
  const replaceInput=document.getElementById('frReplace');
  const countEl=document.getElementById('frCount');
  const replaceBtn=document.getElementById('frReplaceAll');
  const closeBtn=document.getElementById('frClose');
  if(!findInput) return;

  findInput.addEventListener('input',()=>{
    const n=frCountMatches(findInput.value.trim());
    countEl.textContent=n+' match'+(n===1?'':'es');
  });

  replaceBtn.addEventListener('click',()=>{
    const query=findInput.value.trim();
    if(!query) return;
    const replacement=replaceInput.value;
    const n=frReplaceAll(query, replacement);
    countEl.textContent='Replaced '+n+' match'+(n===1?'':'es');
  });

  findInput.addEventListener('keydown',e=>{ if(e.key==='Enter') replaceBtn.click(); });
  closeBtn.addEventListener('click',()=>toggleFindReplace());
})();
</script>
