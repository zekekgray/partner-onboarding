}

/** Inserts a drawn signature (PNG data URL) as an inline image. Falls back
 *  to a plain text line if the value isn't an image data URL. Previously
 *  the raw "data:image/png;base64,...." string would have been printed
 *  as literal text — this was a real conflict between the canvas-based
 *  signature pad (index.html Step 3) and the old typed-name assumption. */
function insertSignatureImage_(body, signatureValue) {
  if (signatureValue && String(signatureValue).indexOf('data:image') === 0) {
    try {
      const base64 = signatureValue.split(',')[1];
      const blob = Utilities.newBlob(Utilities.base64Decode(base64), 'image/png', 'signature.png');
      const img = body.appendImage(blob);
      img.setWidth(180);
      img.setHeight(60);
      return;
    } catch (err) {
      body.appendParagraph('[Signature could not be rendered]');
      return;
    }
  }
  body.appendParagraph(signatureValue || '');
}

/* =========================================================
   SHARED FOLDER HELPER
   ========================================================= */

function getWorkingFolder_(folderName) {
  const folders = DriveApp.getFoldersByName(folderName);
  if (folders.hasNext()) return folders.next();
  return DriveApp.createFolder(folderName);
}

/* Back-compat alias — kept in case any other script references this name directly. */
function getAgreementFolder_() {
  return getWorkingFolder_('ArtiPlay Academy OS — Agreements');
}

/* =========================================================
   DOCUMENT HEADING HELPER
   ========================================================= */

function appendHeading_(body, text) {
  const heading = body.appendParagraph(text);
  heading.setFontFamily('Georgia');
  heading.setFontSize(15);
  heading.setBold(true);
  heading.setSpacingBefore(18);
  heading.setSpacingAfter(8);
  return heading;
}
