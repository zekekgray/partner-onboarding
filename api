/* =========================================================
   SAVE AGREEMENT
   ========================================================= */

function saveAgreementToSheet(data) {

  if (!data) {
    throw new Error('No agreement data was received.');
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheetName = 'Agreements';

  let sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.insertSheet(sheetName);

    sheet.appendRow([
      'Timestamp',
      'Academy Name',
      'Representative',
      'Position',
      'Email',
      'Mobile',
      'Address',
      'Signature',
      'Agreement Date',
      'Accepted',
      'Status'
    ]);

    sheet.setFrozenRows(1);
  }

  sheet.appendRow([
    new Date(),

    data.acad_name || '',
    data.acad_rep || '',
    data.acad_position || '',
    data.acad_email || '',
    data.acad_mobile || '',
    data.acad_address || '',
    data.acad_signature || '',
    data.acad_date || '',
    data.acad_consent ? 'YES' : 'NO',
    'SIGNED'
  ]);

  return {
    success: true,
    message: 'Agreement saved successfully.',
    academy: data.acad_name || '',
    email: data.acad_email || ''
  };
}


