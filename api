/* =========================================================
   AGREEMENT PDF FOLDER
   ========================================================= */

function getAgreementFolder_() {

  const folderName = 'ArtiPlay Academy OS — Agreements';

  const folders = DriveApp.getFoldersByName(folderName);

  if (folders.hasNext()) {
    return folders.next();
  }

  return DriveApp.createFolder(folderName);
}


/* =========================================================
