/* =========================================================
   PENDING PAYMENTS SHEET SCHEMA
   ========================================================= */

const PENDING_SHEET = 'PendingPayments';
const PENDING_HEADERS = [
  'ReferenceID', 'Timestamp', 'AcademyName', 'Representative', 'Position', 'Email', 'Mobile', 'Address',
  'SelectedFeatures', 'Headcount', 'TierMonthly', 'SetupFee', 'GrandTotalDueToday',
  'ChannelId', 'BankLabel', 'AmountSent', 'PaymentReference', 'Signature', 'Status', 'LicenseCode'
];

function getPendingSheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName(PENDING_SHEET);
  if (!sheet) {
    sheet = ss.insertSheet(PENDING_SHEET);
    sheet.appendRow(PENDING_HEADERS);
    sheet.setFrozenRows(1);
  }
  return sheet;
}

/* =========================================================
   SUBMIT PAYMENT REFERENCE
   Called from index.html Step 4 → 5 transition ("Submit for
   verification"). This is the function that used to have no
   backend wiring at all — the wizard just faked success locally.
   ========================================================= */

function submitPaymentReference(data) {
  if (!data) throw new Error('No payment data was received.');

  const required = ['acad_name', 'acad_email', 'channelId', 'referenceNumber'];
  const missing = required.find(k => !data[k]);
  if (missing) throw new Error('Missing required field: ' + missing);

  // Server-side recomputation — never trust the client's displayed total.
  const pricing = computePricing(data.headcount, true);

  const sheet = getPendingSheet_();
  const id = Utilities.getUuid();

  sheet.appendRow([
    id,
    new Date(),
    data.acad_name || '',
    data.acad_rep || '',
    data.acad_position || '',
    data.acad_email || '',
    data.acad_mobile || '',
    data.acad_address || '',
    Array.isArray(data.selectedFeatures) ? data.selectedFeatures.join(', ') : (data.selectedFeatures || ''),
    pricing.headcount,
    pricing.recurringBase,
    pricing.setupFee,
    pricing.grandTotalDueToday,
    data.channelId || '',
    data.bankLabel || '',
    data.amount || '',
    data.referenceNumber || '',
    data.acad_signature ? 'Captured' : '',
    'PENDING',
    ''
  ]);

  return {
    success: true,
    referenceId: id,
    expectedAmount: pricing.grandTotalDueToday,
    amountMatches: Number(data.amount) === pricing.grandTotalDueToday
  };
}

/* =========================================================
   ADMIN: APPROVE PAYMENT
   ========================================================= */

function approvePayment(referenceId) {
  const sheet = getPendingSheet_();
  const rows = sheet.getDataRange().getValues();
  const rowIndex = rows.findIndex(r => r[0] === referenceId);
  if (rowIndex === -1) return { success: false, error: 'Not found' };

  const row = rows[rowIndex];
  const statusCol = PENDING_HEADERS.indexOf('Status') + 1;
  const licenseCol = PENDING_HEADERS.indexOf('LicenseCode') + 1;

  sheet.getRange(rowIndex + 1, statusCol).setValue('APPROVED');

  const licenseCode = generateLicenseCode();
  sheet.getRange(rowIndex + 1, licenseCol).setValue(licenseCode);

  const invoicePdf = generateInvoicePdf(row);
  sendApprovalEmail(row, licenseCode, invoicePdf);

  return { success: true, licenseCode: licenseCode };
}

function generateLicenseCode() {
  return 'ARTIPLAY-' + Utilities.getUuid().split('-')[0].toUpperCase();
}

function sendApprovalEmail(row, licenseCode, invoicePdf) {
  const academyName = row[PENDING_HEADERS.indexOf('AcademyName')];
  const email = row[PENDING_HEADERS.indexOf('Email')];
  if (!email) return;

  MailApp.sendEmail({
    to: email,
    subject: 'ArtiPlay Academy License Approved',
    htmlBody: `
      <p>Hi ${academyName},</p>
      <p>Your payment has been verified. Your academy license code is:</p>
      <h2>${licenseCode}</h2>
      <p>Your invoice is attached.</p>
    `,
    attachments: invoicePdf ? [invoicePdf] : []
  });
}

/* =========================================================
   INVOICE PDF
   (Previously called by sendApprovalEmail() but never defined —
   that was a hard runtime conflict. Implemented here.)
   ========================================================= */

function generateInvoicePdf(row) {
  const academyName     = row[PENDING_HEADERS.indexOf('AcademyName')] || 'Academy';
  const grandTotal       = row[PENDING_HEADERS.indexOf('GrandTotalDueToday')] || 0;
  const setupFee         = row[PENDING_HEADERS.indexOf('SetupFee')] || 0;
  const tierMonthly      = row[PENDING_HEADERS.indexOf('TierMonthly')] || 0;
  const referenceId      = row[PENDING_HEADERS.indexOf('ReferenceID')] || '';
  const paymentReference = row[PENDING_HEADERS.indexOf('PaymentReference')] || '';

  const folder = getWorkingFolder_('ArtiPlay Academy OS — Invoices');
  const documentName = 'ArtiPlay Academy OS — Invoice — ' + academyName;

  const doc = DocumentApp.create(documentName);
  const body = doc.getBody();
  body.clear();

  const title = body.appendParagraph('ARTIPLAY — INVOICE');
  title.setAlignment(DocumentApp.HorizontalAlignment.CENTER);
  title.setFontFamily('Georgia');
  title.setFontSize(22);
  title.setBold(true);

  body.appendParagraph('');
  body.appendParagraph('Billed To: ' + academyName);
  body.appendParagraph('Reference ID: ' + referenceId);
  body.appendParagraph('Payment Reference: ' + paymentReference);
  body.appendParagraph('Date: ' + new Date().toDateString());
  body.appendParagraph('');
  body.appendParagraph('Founding Academy Deployment (one-time): ₱' + setupFee);
  body.appendParagraph('Platform & Infrastructure Fee (first month): ₱' + tierMonthly);
  body.appendParagraph('Grand Total: ₱' + grandTotal).setBold(true);

  doc.saveAndClose();

  const docFile = DriveApp.getFileById(doc.getId());
  const pdfBlob = docFile.getAs(MimeType.PDF).setName(documentName + '.pdf');
  const pdfFile = folder.createFile(pdfBlob);
  docFile.setTrashed(true);

  return pdfFile.getAs(MimeType.PDF);
}

/* =========================================================
   AGREEMENT — SAVE TO SHEET
   Called from the Agreement modal's "Save" button (index.html).
   ========================================================= */

function saveAgreementToSheet(data) {
  if (!data) throw new Error('No agreement data was received.');

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = 'Agreements';
  let sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
    sheet.appendRow([
      'Timestamp', 'Academy Name', 'Representative', 'Position', 'Email', 'Mobile',
      'Address', 'Signature', 'Agreement Date', 'Accepted', 'Status'
    ]);
    sheet.setFrozenRows(1);
  }

  sheet.appendRow([
    new Date(),
    data.acad_name || '',
    data.acad_rep || '',
    data.acad_position || '',
    data.acad_email || '',
    data.acad_mobile || '',
    data.acad_address || '',
    data.acad_signature ? 'Captured' : '',
    data.acad_date || '',
    data.acad_consent ? 'YES' : 'NO',
    'SIGNED'
  ]);

  return {
    success: true,
    message: 'Agreement saved successfully.',
    academy: data.acad_name || '',
    email: data.acad_email || ''
  };
}

