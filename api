function appendHeading_(body, text) {

  const heading = body.appendParagraph(text);

  heading.setFontFamily('Georgia');
  heading.setFontSize(15);
  heading.setBold(true);

  heading.setSpacingBefore(18);
  heading.setSpacingAfter(8);

  return heading;
}
