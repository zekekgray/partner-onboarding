// Customer submits after paying
function submitPaymentReference(data) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('PendingPayments');
  const id = Utilities.getUuid();
  sheet.appendRow([
    id,
    new Date(),
    data.academyName,
    data.channelId,
    data.referenceNumber,
    data.amount,
    'PENDING'
  ]);
  return { success: true, referenceId: id };
}

// Admin approves from ArtiPlay admin panel
function approvePayment(referenceId) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('PendingPayments');
  const rows = sheet.getDataRange().getValues();
  const rowIndex = rows.findIndex(r => r[0] === referenceId);
  if (rowIndex === -1) return { success: false, error: 'Not found' };

  const row = rows[rowIndex];
  sheet.getRange(rowIndex + 1, 7).setValue('APPROVED'); // status col

  const licenseCode = generateLicenseCode();
  sheet.getRange(rowIndex + 1, 8).setValue(licenseCode); // save license col

  const invoicePdf = generateInvoicePdf(row);
  sendApprovalEmail(row, licenseCode, invoicePdf);

  return { success: true, licenseCode };
}

function generateLicenseCode() {
  return 'ARTIPLAY-' + Utilities.getUuid().split('-')[0].toUpperCase();
}

function sendApprovalEmail(row, licenseCode, invoicePdf) {
  const academyName = row[2];
  const email = row[8]; // assuming email column
  MailApp.sendEmail({
    to: email,
    subject: 'ArtiPlay Academy License Approved',
    htmlBody: `
      <p>Hi ${academyName},</p>
      <p>Your payment has been verified. Your academy license code is:</p>
      <h2>${licenseCode}</h2>
      <p>Your invoice is attached.</p>
    `,
    attachments: [invoicePdf]
  });
}
// ===== CLIENT SIDE (checkout.html) =====
async function submitReference() {
  const data = {
    academyName: document.getElementById('academyName').value,
    channelId: document.getElementById('channel').value,
    referenceNumber: document.getElementById('refNumber').value,
    amount: document.getElementById('amount').value
  };

  document.getElementById('submitBtn').disabled = true;
  google.script.run
    .withSuccessHandler(res => {
      showStatus('Submitted! Waiting for admin approval. You will receive your invoice and license code via email.');
    })
    .withFailureHandler(err => {
      showStatus('Error: ' + err.message);
      document.getElementById('submitBtn').disabled = false;
    })
    .submitPaymentReference(data);
}
